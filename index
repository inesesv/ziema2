<!DOCTYPE html>
<html lang="lv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ziemas noskaņa — Video Prezentācija</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter un Playfair Display -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            serif: ['Playfair Display', 'serif'],
          }
        }
      }
    }
  </script>
</head>
<body class="bg-gradient-to-b from-[#030917] via-[#091c38] to-[#112e54] text-slate-100 min-h-screen flex flex-col justify-between relative overflow-x-hidden selection:bg-sky-400 selection:text-slate-900">

  <!-- Fona krītošo sniegpārslu un zvaigžņu audekls (HTML5 Canvas) -->
  <canvas id="winter-canvas" class="fixed inset-0 w-full h-full pointer-events-none z-10"></canvas>

  <!-- Ziemeļblāzmas / ledus spīduma efekti fonā -->
  <div class="fixed top-[-15%] left-[-10%] w-[55vw] h-[55vw] rounded-full bg-emerald-400/10 blur-[130px] pointer-events-none z-0"></div>
  <div class="fixed top-[5%] right-[-10%] w-[50vw] h-[50vw] rounded-full bg-sky-400/15 blur-[130px] pointer-events-none z-0"></div>
  <div class="fixed bottom-[10%] left-[20%] w-[45vw] h-[45vw] rounded-full bg-indigo-500/15 blur-[130px] pointer-events-none z-0"></div>

  <!-- Ziemas kalnu siluets apakšmalā (SVG) -->
  <div class="fixed bottom-0 left-0 right-0 w-full pointer-events-none z-0 overflow-hidden leading-none opacity-80">
    <svg class="w-full h-28 sm:h-44 md:h-56" viewBox="0 0 1440 320" preserveAspectRatio="none">
      <!-- Tālie kalni -->
      <path fill="#07162b" fill-opacity="0.85" d="M0,224L120,186.7C240,149,480,75,720,85.3C960,96,1200,192,1320,240L1440,288L1440,320L1320,320C1200,320,960,320,720,320C480,320,240,320,120,320L0,320Z"></path>
      <!-- Tuvie sniegotie kalni -->
      <path fill="#040d1c" d="M0,288L96,261.3C192,235,384,181,576,186.7C768,192,960,256,1152,261.3C1344,267,1440,213,1440,213L1440,320L1152,320C960,320,768,320,576,320C384,320,192,320,96,320L0,320Z"></path>
    </svg>
  </div>

  <!-- Galvene (Header) -->
  <header class="relative z-20 w-full max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-2 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center shadow-lg shadow-sky-950/40">
        <svg class="w-6 h-6 text-sky-300" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M19.07 4.93L4.93 19.07M12 6l-2-2m2 2l2-2M12 18l-2 2m2-2l2 2M6 12l-2-2m2 2l-2 2M18 12l-2-2m-2 2l2 2"/>
        </svg>
      </div>
      <div>
        <h1 class="text-xl sm:text-2xl font-serif tracking-wide text-white">Ziemas noskaņa</h1>
        <p class="text-xs text-sky-200/75 tracking-wider uppercase">SharePoint &amp; lokālā video telpa</p>
      </div>
    </div>

    <!-- Sniega intensitātes un avota pārslēgs -->
    <div class="flex flex-wrap items-center justify-center gap-2">
      <div class="flex items-center gap-2 bg-white/5 backdrop-blur-md border border-white/15 rounded-full px-4 py-2 text-xs sm:text-sm">
        <span class="text-sky-200/80">Sniegputenis:</span>
        <button id="toggle-snow-btn" type="button" class="font-medium text-sky-300 hover:text-white transition-colors cursor-pointer">
          Aktīvs
        </button>
      </div>
    </div>
  </header>

  <!-- Galvenā satura daļa -->
  <main class="relative z-20 flex-grow flex flex-col items-center justify-center w-full max-w-5xl mx-auto px-4 sm:px-6 py-4 sm:py-8">
    
    <!-- Virsraksts -->
    <div class="text-center max-w-2xl mb-6 sm:mb-8">
      <span class="inline-block px-3.5 py-1 mb-3 text-xs font-medium tracking-widest uppercase rounded-full bg-sky-400/10 text-sky-300 border border-sky-400/20">
        Ziemas nakts prezentācija
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-semibold text-white mb-3 leading-tight drop-shadow">
        Ziemas noskaņa
      </h2>
      <p class="text-sm sm:text-base text-slate-300/90 leading-relaxed">
        Mierpilna ziemas vakara atmosfēra ar ziemeļblāzmas mirdzumu, sniegpārslām un pievienoto video no SharePoint mākoņkrātuves.
      </p>
    </div>

    <!-- Matēta ledus stikla (Glassmorphism) kartīte centrā -->
    <div class="w-full rounded-3xl p-3 sm:p-5 bg-white/[0.08] backdrop-blur-xl border border-white/20 shadow-[0_25px_70px_-15px_rgba(2,10,25,0.9)]">
      
      <!-- Video / Iframe konteiners -->
      <div class="relative w-full aspect-video rounded-2xl overflow-hidden bg-[#030914] border border-white/15">
        
        <!-- 1. Režīms: HTML5 Video (mēģina tiešo straumi ar &download=1) -->
        <video 
          id="winter-video"
          class="w-full h-full object-cover"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        >
          Jūsu pārlūkprogramma neatbalsta HTML5 video atskaņošanu.
        </video>

        <!-- 2. Režīms: SharePoint Iframe (action=embedview) -->
        <iframe
          id="sharepoint-iframe"
          class="hidden w-full h-full border-0 bg-[#050e1f]"
          allow="autoplay; fullscreen; encrypted-media"
          allowfullscreen
          title="SharePoint Ziemas Video"
        ></iframe>

        <!-- 3. Režīms: Rezerves skats, ja pārlūks vai SharePoint politika bloķē iegulšanu -->
        <div id="fallback-overlay" class="hidden absolute inset-0 flex flex-col items-center justify-center p-5 sm:p-8 text-center bg-gradient-to-br from-[#061329]/95 to-[#0c2345]/95 backdrop-blur-md z-10">
          <div class="w-14 h-14 sm:w-16 sm:h-16 mb-4 rounded-2xl bg-sky-400/15 border border-sky-300/30 flex items-center justify-center text-sky-300 shadow-lg">
            <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-lg sm:text-xl font-semibold text-white mb-2">
            SharePoint ierobežo tiešu automātisko straumēšanu
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 max-w-lg mb-5 leading-relaxed">
            Organizācijas SharePoint saite pieprasa autentifikāciju vai bloķē tiešu <code class="text-sky-200">&lt;video&gt;</code> straumi. Varat atvērt video oriģinālajā SharePoint logā vai ielādēt lokālo <strong class="text-white">animacija.mp4</strong> failu no datora:
          </p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            <a 
              id="fallback-sharepoint-link"
              href="https://citadaskola-my.sharepoint.com/:v:/g/personal/inese_vilumsone_citadaskola_lv/IQCKh6kYJiiIR7SRLT24kGgXAUgsh6KXWTUXlyreIAARaGM?nav=eyJyZWZlcnJhbEluZm8iOnsicmVmZXJyYWxBcHAiOiJPbmVEcml2ZUZvckJ1c2luZXNzIiwicmVmZXJyYWxBcHBQbGF0Zm9ybSI6IldlYiIsInJlZmVycmFsTW9kZSI6InZpZXciLCJyZWZlcnJhbFZpZXciOiJNeUZpbGVzTGlua0NvcHkifX0&e=jz6deG" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-semibold text-xs sm:text-sm shadow-lg shadow-sky-500/25 transition-all"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
              <span>Atvērt video SharePoint</span>
            </a>

            <label class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-white font-medium text-xs sm:text-sm transition-all cursor-pointer">
              <svg class="w-4 h-4 text-sky-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
              </svg>
              <span>Ielādēt animacija.mp4 no datora</span>
              <input id="fallback-file-input" type="file" accept="video/mp4,video/*" class="hidden">
            </label>
          </div>
        </div>

      </div>

      <!-- Vadības panelis zem video -->
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 px-1">
        
        <!-- Kreisā puse: Video atskaņošanas un skaņas pogas -->
        <div id="html5-controls" class="flex flex-wrap items-center gap-2">
          <button id="play-pause-btn" type="button" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 active:scale-95 border border-white/15 text-xs sm:text-sm font-medium text-white transition-all cursor-pointer">
            <svg id="icon-pause" class="w-4 h-4 text-sky-300" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
            </svg>
            <svg id="icon-play" class="w-4 h-4 text-sky-300 hidden" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
            <span id="play-pause-text">Pauzēt</span>
          </button>

          <button id="mute-btn" type="button" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-sky-500/20 hover:bg-sky-500/30 active:scale-95 border border-sky-400/30 text-xs sm:text-sm font-medium text-sky-200 transition-all cursor-pointer">
            <svg id="icon-muted" class="w-4 h-4 text-sky-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/>
            </svg>
            <svg id="icon-unmuted" class="w-4 h-4 text-sky-300 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/>
            </svg>
            <span id="mute-text">Ieslēgt skaņu</span>
          </button>
        </div>

        <!-- Labā puse: Režīmu pārslēgšana un SharePoint / lokālā faila pogas -->
        <div class="flex flex-wrap items-center gap-2">
          <!-- Tiešā saite uz SharePoint -->
          <a 
            href="https://citadaskola-my.sharepoint.com/:v:/g/personal/inese_vilumsone_citadaskola_lv/IQCKh6kYJiiIR7SRLT24kGgXAUgsh6KXWTUXlyreIAARaGM?nav=eyJyZWZlcnJhbEluZm8iOnsicmVmZXJyYWxBcHAiOiJPbmVEcml2ZUZvckJ1c2luZXNzIiwicmVmZXJyYWxBcHBQbGF0Zm9ybSI6IldlYiIsInJlZmVycmFsTW9kZSI6InZpZXciLCJyZWZlcnJhbFZpZXciOiJNeUZpbGVzTGlua0NvcHkifX0&e=jz6deG" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-sky-500/15 hover:bg-sky-500/25 border border-sky-400/25 text-xs sm:text-sm font-medium text-sky-200 transition-all"
          >
            <svg class="w-4 h-4 text-sky-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
            <span>Atvērt video SharePoint</span>
          </a>

          <!-- Pārslēgt uz Embed Iframe skatu manuāli -->
          <button id="switch-embed-btn" type="button" class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-white/5 hover:bg-white/15 border border-white/10 text-xs sm:text-sm text-slate-300 hover:text-white transition-all cursor-pointer">
            <span>SharePoint iegultais skats</span>
          </button>

          <!-- Ielādēt animacija.mp4 no datora -->
          <label class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-white/5 hover:bg-white/15 border border-white/10 text-xs sm:text-sm text-slate-300 hover:text-white transition-all cursor-pointer">
            <svg class="w-4 h-4 text-sky-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
            </svg>
            <span>Ielādēt no datora</span>
            <input id="toolbar-file-input" type="file" accept="video/mp4,video/*" class="hidden">
          </label>
        </div>

      </div>

      <!-- Diskrēta statusa josla, kas paskaidro SharePoint pieslēguma statusu -->
      <div class="mt-4 pt-3 border-t border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-2 px-1 text-xs text-slate-300/85">
        <div class="flex items-center gap-2">
          <span id="status-dot" class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-pulse shrink-0"></span>
          <span id="status-message">Inicializē SharePoint tiešo video straumi (<code class="text-sky-200">&amp;download=1</code>)...</span>
        </div>
        <div class="text-slate-400 text-[11px]">
          Režīms: <span id="mode-badge" class="text-sky-300 font-medium">HTML5 Tiešā straume</span>
        </div>
      </div>

    </div>

  </main>

  <!-- Kājene (Footer) -->
  <footer class="relative z-20 w-full max-w-6xl mx-auto px-4 sm:px-6 py-5 text-center text-xs text-slate-400/90">
    <p>Ziemas noskaņas tīmekļa lapa &bull; Automātiska pielāgošanās SharePoint straumei, iegultajam skatam vai lokālajam <span class="text-sky-300">animacija.mp4</span> failam</p>
  </footer>

  <script>
    /**
     * 1. SharePoint saišu konfigurācija
     */
    const SHAREPOINT_BASE_URL = "https://citadaskola-my.sharepoint.com/:v:/g/personal/inese_vilumsone_citadaskola_lv/IQCKh6kYJiiIR7SRLT24kGgXAUgsh6KXWTUXlyreIAARaGM?nav=eyJyZWZlcnJhbEluZm8iOnsicmVmZXJyYWxBcHAiOiJPbmVEcml2ZUZvckJ1c2luZXNzIiwicmVmZXJyYWxBcHBQbGF0Zm9ybSI6IldlYiIsInJlZmVycmFsTW9kZSI6InZpZXciLCJyZWZlcnJhbFZpZXciOiJNeUZpbGVzTGlua0NvcHkifX0&e=jz6deG";
    
    // Tiešās lejupielādes mēģinājuma saite HTML5 <video> tagam
    const SHAREPOINT_DIRECT_URL = SHAREPOINT_BASE_URL + "&download=1";
    
    // SharePoint iegultā skata saite <iframe> elementam
    const SHAREPOINT_EMBED_URL = SHAREPOINT_BASE_URL + "&action=embedview&wdStartOn=1";

    /**
     * 2. DOM elementu atsauces
     */
    const videoEl = document.getElementById('winter-video');
    const iframeEl = document.getElementById('sharepoint-iframe');
    const fallbackOverlay = document.getElementById('fallback-overlay');
    const html5Controls = document.getElementById('html5-controls');

    const statusDot = document.getElementById('status-dot');
    const statusMessage = document.getElementById('status-message');
    const modeBadge = document.getElementById('mode-badge');

    const playPauseBtn = document.getElementById('play-pause-btn');
    const playPauseText = document.getElementById('play-pause-text');
    const iconPlay = document.getElementById('icon-play');
    const iconPause = document.getElementById('icon-pause');

    const muteBtn = document.getElementById('mute-btn');
    const muteText = document.getElementById('mute-text');
    const iconMuted = document.getElementById('icon-muted');
    const iconUnmuted = document.getElementById('icon-unmuted');

    const switchEmbedBtn = document.getElementById('switch-embed-btn');
    const fallbackFileInput = document.getElementById('fallback-file-input');
    const toolbarFileInput = document.getElementById('toolbar-file-input');

    let currentMode = 'direct'; // 'direct' | 'embed' | 'local' | 'fallback'

    /**
     * 3. Statusa joslas un pogu stāvokļa atjaunināšana
     */
    function setStatus(type, text, badgeText) {
      statusMessage.innerHTML = text;
      modeBadge.textContent = badgeText;
      statusDot.className = 'w-2.5 h-2.5 rounded-full shrink-0 ';

      if (type === 'success') {
        statusDot.classList.add('bg-emerald-400', 'animate-pulse');
      } else if (type === 'warning') {
        statusDot.classList.add('bg-amber-400', 'animate-pulse');
      } else if (type === 'error') {
        statusDot.classList.add('bg-rose-400');
      } else {
        statusDot.classList.add('bg-sky-400', 'animate-pulse');
      }
    }

    function updatePlayPauseUI() {
      if (videoEl.paused) {
        playPauseText.textContent = 'Atskaņot';
        iconPlay.classList.remove('hidden');
        iconPause.classList.add('hidden');
      } else {
        playPauseText.textContent = 'Pauzēt';
        iconPlay.classList.add('hidden');
        iconPause.classList.remove('hidden');
      }
    }

    function updateMuteUI() {
      if (videoEl.muted) {
        muteText.textContent = 'Ieslēgt skaņu';
        iconMuted.classList.remove('hidden');
        iconUnmuted.classList.add('hidden');
      } else {
        muteText.textContent = 'Izslēgt skaņu';
        iconMuted.classList.add('hidden');
        iconUnmuted.classList.remove('hidden');
      }
    }

    /**
     * 4. Viedā video ielādes un pārslēgšanās loģika
     */
    function startDirectStream() {
      currentMode = 'direct';
      iframeEl.classList.add('hidden');
      fallbackOverlay.classList.add('hidden');
      videoEl.classList.remove('hidden');
      html5Controls.classList.remove('opacity-40', 'pointer-events-none');

      setStatus(
        'info',
        'Mēģina automātiski atskaņot SharePoint tiešo straumi (<code class="text-sky-200">&amp;download=1</code>)...',
        'HTML5 Tiešā straume'
      );

      videoEl.muted = true;
      videoEl.src = SHAREPOINT_DIRECT_URL;

      const playPromise = videoEl.play();
      if (playPromise !== undefined) {
        playPromise
          .then(() => {
            setStatus(
              'success',
              'SharePoint video veiksmīgi atskaņojas automātiski (bez skaņas).',
              'HTML5 Aktīvs'
            );
            updatePlayPauseUI();
            updateMuteUI();
          })
          .catch(() => {
            // Ja pārlūks aizkavē autoplay, atjaunina pogas
            updatePlayPauseUI();
          });
      }
    }

    function switchToEmbedIframe(isAutoFallback = false) {
      currentMode = 'embed';
      videoEl.pause();
      videoEl.classList.add('hidden');
      fallbackOverlay.classList.add('hidden');
      iframeEl.classList.remove('hidden');
      html5Controls.classList.add('opacity-40', 'pointer-events-none');

      iframeEl.src = SHAREPOINT_EMBED_URL;

      if (isAutoFallback) {
        setStatus(
          'warning',
          'Tiešā MP4 straume bloķēta (CORS/autentifikācija) — automātiski pārslēgts uz SharePoint iegulto skatu.',
          'SharePoint Iframe'
        );
      } else {
        setStatus(
          'info',
          'Ielādēts SharePoint iegultais video atskaņotājs (<code class="text-sky-200">action=embedview</code>).',
          'SharePoint Iframe'
        );
      }
    }

    function showFallbackView() {
      currentMode = 'fallback';
      videoEl.classList.add('hidden');
      iframeEl.classList.add('hidden');
      fallbackOverlay.classList.remove('hidden');
      html5Controls.classList.add('opacity-40', 'pointer-events-none');

      setStatus(
        'error',
        'SharePoint liedz iegulšanu ārējā lapā. Izmantojiet pogu "Atvērt video SharePoint" vai ielādējiet failu no datora.',
        'Nepieciešama darbība'
      );
    }

    // Ja HTML5 <video> ar SharePoint &download=1 saiti neizdodas (CORS, 403, HTML lapa MP4 vietā)
    videoEl.addEventListener('error', () => {
      if (currentMode === 'direct') {
        // Automātiski pārslēdzas uz SharePoint embed iframe skatu
        switchToEmbedIframe(true);
      } else if (currentMode === 'local') {
        setStatus('error', 'Neizdevās nolasīt izvēlēto lokālo video failu.', 'Kļūda');
      }
    });

    videoEl.addEventListener('loadeddata', () => {
      if (currentMode === 'direct') {
        setStatus(
          'success',
          'SharePoint video straume ir gatava un atskaņojas automātiski.',
          'HTML5 Aktīvs'
        );
      }
      updatePlayPauseUI();
      updateMuteUI();
    });

    videoEl.addEventListener('play', updatePlayPauseUI);
    videoEl.addEventListener('pause', updatePlayPauseUI);

    // Manuāla pārslēgšanās starp SharePoint Embed un rezerves logu
    switchEmbedBtn.addEventListener('click', () => {
      if (currentMode === 'embed') {
        showFallbackView();
        switchEmbedBtn.textContent = 'SharePoint iegultais skats';
      } else {
        switchToEmbedIframe(false);
        switchEmbedBtn.textContent = 'Rādīt palīdzības logu';
      }
    });

    // Atskaņot / Pauzēt poga
    playPauseBtn.addEventListener('click', () => {
      if (videoEl.paused) {
        videoEl.play().catch(() => {});
      } else {
        videoEl.pause();
      }
    });

    // Skaņas poga
    muteBtn.addEventListener('click', () => {
      videoEl.muted = !videoEl.muted;
      updateMuteUI();
    });

    // Lokāla animacija.mp4 faila ielāde no lietotāja datora
    function handleLocalFileSelect(event) {
      const file = event.target.files[0];
      if (!file) return;

      currentMode = 'local';
      const localUrl = URL.createObjectURL(file);

      iframeEl.classList.add('hidden');
      iframeEl.src = '';
      fallbackOverlay.classList.add('hidden');
      videoEl.classList.remove('hidden');
      html5Controls.classList.remove('opacity-40', 'pointer-events-none');

      videoEl.src = localUrl;
      videoEl.muted = true;
      videoEl.play()
        .then(() => {
          setStatus(
            'success',
            `Atskaņo lokālo failu: <strong class="text-white">${file.name}</strong>`,
            'Lokālais fails'
          );
          updatePlayPauseUI();
          updateMuteUI();
        })
        .catch(() => {
          updatePlayPauseUI();
        });
    }

    fallbackFileInput.addEventListener('change', handleLocalFileSelect);
    toolbarFileInput.addEventListener('change', handleLocalFileSelect);

    /**
     * 5. HTML5 Canvas: Mirdzošas zvaigznes un krītošas sniegpārslas
     */
    const canvas = document.getElementById('winter-canvas');
    const ctx = canvas.getContext('2d');
    let snowflakes = [];
    let stars = [];
    let snowEnabled = true;

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }

    function initWinterParticles() {
      const width = canvas.width;
      const height = canvas.height;

      // Zvaigznes augšējā debesu daļā
      const starCount = Math.min(Math.floor(width / 18), 90);
      stars = [];
      for (let i = 0; i < starCount; i++) {
        stars.push({
          x: Math.random() * width,
          y: Math.random() * (height * 0.65),
          radius: Math.random() * 1.5 + 0.4,
          alpha: Math.random(),
          twinkleSpeed: Math.random() * 0.02 + 0.005
        });
      }

      // Krītošās sniegpārslas
      const flakeCount = Math.min(Math.floor(width / 8), 160);
      snowflakes = [];
      for (let i = 0; i < flakeCount; i++) {
        snowflakes.push({
          x: Math.random() * width,
          y: Math.random() * height,
          radius: Math.random() * 3.2 + 1,
          speedY: Math.random() * 1.15 + 0.35,
          speedX: Math.random() * 0.5 - 0.25,
          opacity: Math.random() * 0.7 + 0.25,
          sway: Math.random() * Math.PI * 2
        });
      }
    }

    function animateWinterScene() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Zīmē mirdzošās zvaigznes
      for (let i = 0; i < stars.length; i++) {
        const s = stars[i];
        s.alpha += s.twinkleSpeed;
        const currentAlpha = 0.25 + Math.abs(Math.sin(s.alpha)) * 0.75;

        ctx.beginPath();
        ctx.arc(s.x, s.y, s.radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(224, 242, 254, ${currentAlpha * 0.75})`;
        ctx.fill();
      }

      // Zīmē krītošās sniegpārslas
      if (snowEnabled) {
        for (let i = 0; i < snowflakes.length; i++) {
          const f = snowflakes[i];
          f.sway += 0.015;
          f.y += f.speedY;
          f.x += f.speedX + Math.sin(f.sway) * 0.35;

          if (f.y > canvas.height + 5) {
            f.y = -5;
            f.x = Math.random() * canvas.width;
          }
          if (f.x > canvas.width + 5) f.x = -5;
          if (f.x < -5) f.x = canvas.width + 5;

          ctx.beginPath();
          ctx.arc(f.x, f.y, f.radius, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(240, 249, 255, ${f.opacity})`;
          ctx.fill();
        }
      }

      requestAnimationFrame(animateWinterScene);
    }

    window.addEventListener('resize', () => {
      resizeCanvas();
      initWinterParticles();
    });

    const toggleSnowBtn = document.getElementById('toggle-snow-btn');
    toggleSnowBtn.addEventListener('click', () => {
      snowEnabled = !snowEnabled;
      toggleSnowBtn.textContent = snowEnabled ? 'Aktīvs' : 'Izslēgts';
      toggleSnowBtn.className = snowEnabled
        ? 'font-medium text-sky-300 hover:text-white transition-colors cursor-pointer'
        : 'font-medium text-slate-400 hover:text-white transition-colors cursor-pointer';
    });

    // Lapas palaišana pēc pilnas ielādes
    window.onload = function () {
      resizeCanvas();
      initWinterParticles();
      animateWinterScene();
      startDirectStream();
    };
  </script>
</body>
</html>
