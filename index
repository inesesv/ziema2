<!DOCTYPE html>
<html lang="lv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ziemas Pasaka — Video Prezentācija</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter un Playfair Display -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            serif: ['Playfair Display', 'serif'],
          },
          colors: {
            midnight: '#061121',
            deepblue: '#0b1d36',
            icy: '#38bdf8',
            frost: 'rgba(255, 255, 255, 0.08)',
          }
        }
      }
    }
  </script>
</head>
<body class="bg-gradient-to-b from-[#040d1a] via-[#0b1f3a] to-[#122e52] text-slate-100 min-h-screen flex flex-col justify-between relative overflow-x-hidden selection:bg-sky-400 selection:text-slate-900">

  <!-- Fona krītošo sniegpārslu audekls (Canvas) -->
  <canvas id="snow-canvas" class="fixed inset-0 w-full h-full pointer-events-none z-10"></canvas>

  <!-- Dekoratīvs ziemeļblāzmas / ledus spīdums fonā -->
  <div class="fixed top-[-15%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-sky-500/10 blur-[120px] pointer-events-none z-0"></div>
  <div class="fixed bottom-[-15%] right-[-10%] w-[45vw] h-[45vw] rounded-full bg-indigo-500/15 blur-[120px] pointer-events-none z-0"></div>

  <!-- Galvene (Header) -->
  <header class="relative z-20 w-full max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-4 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <!-- Sniegpārslas SVG ikona -->
      <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center shadow-lg shadow-sky-900/30">
        <svg class="w-6 h-6 text-sky-300" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M19.07 4.93L4.93 19.07M12 6l-2-2m2 2l2-2M12 18l-2 2m2-2l2 2M6 12l-2-2m2 2l-2 2M18 12l2-2m-2 2l2 2"/>
        </svg>
      </div>
      <div>
        <h1 class="text-xl sm:text-2xl font-serif tracking-wide text-white">Ziemas Burvība</h1>
        <p class="text-xs text-sky-200/70 tracking-wider uppercase">Atmosfēriskā video telpa</p>
      </div>
    </div>

    <!-- Sniega intensitātes pārslēgs -->
    <div class="flex items-center gap-2 bg-white/5 backdrop-blur-md border border-white/15 rounded-full px-4 py-2 text-xs sm:text-sm">
      <span class="text-sky-200/80">Sniegputenis:</span>
      <button id="toggle-snow-btn" type="button" class="font-medium text-sky-300 hover:text-white transition-colors cursor-pointer">
        Aktīvs
      </button>
    </div>
  </header>

  <!-- Galvenā satura daļa -->
  <main class="relative z-20 flex-grow flex flex-col items-center justify-center w-full max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
    
    <!-- Ievada virsraksts -->
    <div class="text-center max-w-2xl mb-8">
      <span class="inline-block px-3 py-1 mb-3 text-xs font-medium tracking-widest uppercase rounded-full bg-sky-400/10 text-sky-300 border border-sky-400/20">
        Automātiskā atskaņošana
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-semibold text-white mb-3 leading-tight drop-shadow-sm">
        Klusā ziemas vakara noskaņa
      </h2>
      <p class="text-sm sm:text-base text-slate-300/90 leading-relaxed">
        Izbaudi mierpilnu ziemas animāciju. Video failam <code class="px-1.5 py-0.5 rounded bg-white/10 text-sky-200 font-mono text-xs sm:text-sm">animacija.mp4</code> ir iestatīta automātiska palaišana bez skaņas, lai nodrošinātu nevainojamu darbību visās pārlūkprogrammās.
      </p>
    </div>

    <!-- Ledus stikla (Glassmorphism) Video Konteiners -->
    <div class="w-full rounded-3xl p-3 sm:p-5 bg-white/[0.07] backdrop-blur-xl border border-white/20 shadow-[0_20px_60px_-15px_rgba(2,12,27,0.85)] transition-all">
      
      <!-- Video rāmis -->
      <div class="relative w-full aspect-video rounded-2xl overflow-hidden bg-[#030914] border border-white/10 group">
        
        <!-- HTML5 Video elements ar autoplay, muted, loop un playsinline -->
        <video 
          id="winter-video"
          class="w-full h-full object-cover"
          src="animacija.mp4"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        >
          Jūsu pārlūkprogramma neatbalsta HTML5 video atskaņošanu.
        </video>

        <!-- Rezerves paziņojums, ja animacija.mp4 vēl nav atrasts serverī/mapē -->
        <div id="video-fallback" class="hidden absolute inset-0 flex flex-col items-center justify-center p-6 text-center bg-gradient-to-br from-[#07152b]/95 to-[#0d2547]/95 backdrop-blur-md z-10">
          <div class="w-16 h-16 mb-4 rounded-2xl bg-sky-400/15 border border-sky-300/30 flex items-center justify-center text-sky-300">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-lg sm:text-xl font-semibold text-white mb-2">
            Video fails <span class="text-sky-300 font-mono">animacija.mp4</span> netika atrasts
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 max-w-md mb-5 leading-relaxed">
            Lai video atskaņotos automātiski, novietojiet failu <strong class="text-white">animacija.mp4</strong> tajā pašā mapē, kur atrodas šī HTML lapa, vai izvēlieties video failu no sava datora tūlītējam priekšskatījumam:
          </p>
          <label class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-semibold text-sm shadow-lg shadow-sky-500/25 transition-all cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
            </svg>
            <span>Izvēlēties video failu (.mp4)</span>
            <input id="local-video-input" type="file" accept="video/mp4,video/*" class="hidden">
          </label>
        </div>

        <!-- Statusa indikators augšējā kreisajā stūrī -->
        <div class="absolute top-3 left-3 sm:top-4 sm:left-4 z-20 flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-950/60 backdrop-blur-md border border-white/15 text-xs text-slate-200">
          <span id="status-dot" class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="status-text">Atskaņo: animacija.mp4</span>
        </div>

      </div>

      <!-- Vadības panelis zem video -->
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 px-1">
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          <!-- Atskaņot / Pauzēt poga -->
          <button id="play-pause-btn" type="button" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 active:scale-95 border border-white/15 text-sm font-medium text-white transition-all cursor-pointer">
            <svg id="icon-pause" class="w-4 h-4 text-sky-300" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
            </svg>
            <svg id="icon-play" class="w-4 h-4 text-sky-300 hidden" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
            <span id="play-pause-text">Pauzēt</span>
          </button>

          <!-- Skaņas ieslēgšanas / izslēgšanas poga -->
          <button id="mute-btn" type="button" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-sky-500/20 hover:bg-sky-500/30 active:scale-95 border border-sky-400/30 text-sm font-medium text-sky-200 transition-all cursor-pointer">
            <!-- Izslēgtas skaņas ikona -->
            <svg id="icon-muted" class="w-4 h-4 text-sky-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/>
            </svg>
            <!-- Ieslēgtas skaņas ikona -->
            <svg id="icon-unmuted" class="w-4 h-4 text-sky-300 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/>
            </svg>
            <span id="mute-text">Ieslēgt skaņu</span>
          </button>
        </div>

        <!-- Poga lokāla faila ielādei jebkurā brīdī -->
        <label class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs sm:text-sm text-slate-300 hover:text-white transition-all cursor-pointer">
          <svg class="w-4 h-4 text-sky-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
          </svg>
          <span>Mainīt video failu</span>
          <input id="toolbar-video-input" type="file" accept="video/mp4,video/*" class="hidden">
        </label>
      </div>
    </div>

    <!-- Ziemas noskaņas informācijas kartītes -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 w-full mt-8">
      <div class="p-5 rounded-2xl bg-white/[0.05] backdrop-blur-md border border-white/10">
        <div class="text-sky-300 font-semibold text-sm mb-1">Automātiskā palaišana</div>
        <p class="text-xs sm:text-sm text-slate-300/80 leading-relaxed">
          Video ir konfigurēts ar <code class="text-sky-200">autoplay muted loop playsinline</code>, lai tas uzreiz sāktos gan datoros, gan viedtālruņos.
        </p>
      </div>
      <div class="p-5 rounded-2xl bg-white/[0.05] backdrop-blur-md border border-white/10">
        <div class="text-sky-300 font-semibold text-sm mb-1">Dzīvīgs sniegputenis</div>
        <p class="text-xs sm:text-sm text-slate-300/80 leading-relaxed">
          Fona audekls nepārtraukti ģenerē maigas, dažāda dziļuma un ātruma sniegpārslas ziemas atmosfēras pastiprināšanai.
        </p>
      </div>
      <div class="p-5 rounded-2xl bg-white/[0.05] backdrop-blur-md border border-white/10">
        <div class="text-sky-300 font-semibold text-sm mb-1">Vienkārša uzstādīšana</div>
        <p class="text-xs sm:text-sm text-slate-300/80 leading-relaxed">
          Saglabājiet šo lapu kā <code class="text-sky-200">index.html</code> un novietojiet blakus savu <code class="text-sky-200">animacija.mp4</code> failu.
        </p>
      </div>
    </div>

  </main>

  <!-- Kājene (Footer) -->
  <footer class="relative z-20 w-full max-w-6xl mx-auto px-4 sm:px-6 py-6 text-center text-xs text-slate-400 border-t border-white/10">
    <p>Ziemas noskaņas tīmekļa lapa &bull; Izstrādāta automātiskai <span class="text-sky-300">animacija.mp4</span> atskaņošanai</p>
  </footer>

  <script>
    /**
     * 1. Sniegpārslu animācijas pārvaldība (HTML5 Canvas)
     */
    const canvas = document.getElementById('snow-canvas');
    const ctx = canvas.getContext('2d');
    let snowflakes = [];
    let snowActive = true;
    let animationFrameId = null;

    // Pielāgo audekla izmēru loga izmēram
    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }

    // Izveido sniegpārslu masīvu atbilstoši ekrāna platumam
    function createSnowflakes() {
      const count = Math.min(Math.floor(window.innerWidth / 8), 160);
      snowflakes = [];
      for (let i = 0; i < count; i++) {
        snowflakes.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          radius: Math.random() * 3.2 + 1,
          speedY: Math.random() * 1.2 + 0.4,
          speedX: Math.random() * 0.6 - 0.3,
          opacity: Math.random() * 0.65 + 0.25,
          sway: Math.random() * Math.PI * 2
        });
      }
    }

    // Zīmē un atjaunina sniegpārslu pozīcijas
    function renderSnow() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      if (snowActive) {
        for (let i = 0; i < snowflakes.length; i++) {
          const flake = snowflakes[i];
          flake.sway += 0.015;
          flake.y += flake.speedY;
          flake.x += flake.speedX + Math.sin(flake.sway) * 0.35;

          // Atgriež sniegpārslu augšpusē, kad tā sasniedz apakšu
          if (flake.y > canvas.height + 5) {
            flake.y = -5;
            flake.x = Math.random() * canvas.width;
          }
          if (flake.x > canvas.width + 5) flake.x = -5;
          if (flake.x < -5) flake.x = canvas.width + 5;

          ctx.beginPath();
          ctx.arc(flake.x, flake.y, flake.radius, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(224, 242, 254, ${flake.opacity})`;
          ctx.fill();
        }
      }

      animationFrameId = requestAnimationFrame(renderSnow);
    }

    window.addEventListener('resize', () => {
      resizeCanvas();
      createSnowflakes();
    });

    // Sniegputeņa ieslēgšanas/izslēgšanas poga
    const toggleSnowBtn = document.getElementById('toggle-snow-btn');
    toggleSnowBtn.addEventListener('click', () => {
      snowActive = !snowActive;
      toggleSnowBtn.textContent = snowActive ? 'Aktīvs' : 'Izslēgts';
      toggleSnowBtn.className = snowActive
        ? 'font-medium text-sky-300 hover:text-white transition-colors cursor-pointer'
        : 'font-medium text-slate-400 hover:text-white transition-colors cursor-pointer';
    });

    /**
     * 2. Video atskaņotāja un kļūdu apstrādes loģika
     */
    const video = document.getElementById('winter-video');
    const fallbackBox = document.getElementById('video-fallback');
    const statusDot = document.getElementById('status-dot');
    const statusText = document.getElementById('status-text');

    const playPauseBtn = document.getElementById('play-pause-btn');
    const playPauseText = document.getElementById('play-pause-text');
    const iconPlay = document.getElementById('icon-play');
    const iconPause = document.getElementById('icon-pause');

    const muteBtn = document.getElementById('mute-btn');
    const muteText = document.getElementById('mute-text');
    const iconMuted = document.getElementById('icon-muted');
    const iconUnmuted = document.getElementById('icon-unmuted');

    const localVideoInput = document.getElementById('local-video-input');
    const toolbarVideoInput = document.getElementById('toolbar-video-input');

    // Atjaunina Atskaņot/Pauzēt pogas stāvokli
    function updatePlayState() {
      if (video.paused) {
        playPauseText.textContent = 'Atskaņot';
        iconPlay.classList.remove('hidden');
        iconPause.classList.add('hidden');
        statusDot.classList.remove('bg-emerald-400', 'animate-pulse');
        statusDot.classList.add('bg-amber-400');
      } else {
        playPauseText.textContent = 'Pauzēt';
        iconPlay.classList.add('hidden');
        iconPause.classList.remove('hidden');
        statusDot.classList.remove('bg-amber-400', 'bg-rose-400');
        statusDot.classList.add('bg-emerald-400', 'animate-pulse');
      }
    }

    // Atjaunina Skaņas pogas stāvokli
    function updateMuteState() {
      if (video.muted) {
        muteText.textContent = 'Ieslēgt skaņu';
        iconMuted.classList.remove('hidden');
        iconUnmuted.classList.add('hidden');
      } else {
        muteText.textContent = 'Izslēgt skaņu';
        iconMuted.classList.add('hidden');
        iconUnmuted.classList.remove('hidden');
      }
    }

    // Mēģina automātiski palaist video ielādes brīdī
    function attemptAutoplay() {
      video.muted = true; // Obligāti pārlūkprogrammu autoplay politikai
      const playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise
          .then(() => {
            fallbackBox.classList.add('hidden');
            updatePlayState();
            updateMuteState();
          })
          .catch((err) => {
            console.warn('Automātiskā atskaņošana tika aizkavēta:', err);
            updatePlayState();
          });
      }
    }

    // Parāda rezerves logu, ja animacija.mp4 netiek atrasts
    video.addEventListener('error', () => {
      fallbackBox.classList.remove('hidden');
      statusText.textContent = 'Fails animacija.mp4 nav atrasts';
      statusDot.classList.remove('bg-emerald-400', 'animate-pulse');
      statusDot.classList.add('bg-rose-400');
    });

    video.addEventListener('loadeddata', () => {
      fallbackBox.classList.add('hidden');
      attemptAutoplay();
    });

    video.addEventListener('play', updatePlayState);
    video.addEventListener('pause', updatePlayState);

    // Pogu klikšķu apstrāde
    playPauseBtn.addEventListener('click', () => {
      if (video.paused) {
        video.play().catch(() => {});
      } else {
        video.pause();
      }
    });

    muteBtn.addEventListener('click', () => {
      video.muted = !video.muted;
      updateMuteState();
    });

    // Lokāla video faila ielāde priekšskatījumam
    function handleFileUpload(event) {
      const file = event.target.files[0];
      if (!file) return;
      const objectURL = URL.createObjectURL(file);
      video.src = objectURL;
      fallbackBox.classList.add('hidden');
      statusText.textContent = `Atskaņo: ${file.name}`;
      video.play().catch(() => {});
    }

    localVideoInput.addEventListener('change', handleFileUpload);
    toolbarVideoInput.addEventListener('change', handleFileUpload);

    // Inicializācija, kad lapa ir pilnībā ielādēta
    window.onload = function () {
      resizeCanvas();
      createSnowflakes();
      renderSnow();
      attemptAutoplay();
    };
  </script>
</body>
</html>
